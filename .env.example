# Copy this file to `.env` when running the non-demo runtime locally or through
# `docker compose`.

# Postgres bootstrap target
POSTGRES_USER=stratawiki
POSTGRES_PASSWORD=stratawiki
POSTGRES_DB=stratawiki_dev
DATABASE_URL=postgresql://stratawiki:stratawiki@postgres:5432/stratawiki_dev

# Runtime-owned storage and bootstrap paths
STRATAWIKI_RENDER_ROOT=/var/lib/stratawiki/render
STRATAWIKI_POSTGRES_BOOTSTRAP_SQL=/app/config/postgres/bootstrap.sql
STRATAWIKI_DOMAIN_PACK_PATHS=/app/examples/domain-packs/recruiting.v2026-04-18.json
STRATAWIKI_ACTIVE_DOMAIN_PACKS=recruiting=2026-04-18
STRATAWIKI_HTTP_HOST=0.0.0.0
STRATAWIKI_HTTP_PORT=8080

# Optional LLM provider configuration.
# Leave these blank to use the deterministic local fallback.
OPENAI_API_KEY=
OPENAI_BASE_URL=
WIKI_MCP_DEFAULT_PROVIDER=
WIKI_MCP_OPENAI_MODEL_BALANCED_DEFAULT=
WIKI_MCP_OPENAI_MODEL_DEEP_SYNTHESIS=
WIKI_MCP_ENABLE_OLLAMA=
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
WIKI_MCP_OLLAMA_MODEL_BALANCED_DEFAULT=
WIKI_MCP_OLLAMA_MODEL_DEEP_SYNTHESIS=
